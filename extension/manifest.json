{
    "name": "Lüdd Integration Module",
    "action": {},
    "manifest_version": 3,
    "version": "0.1.0",
    "description": "Download with Lüdd.",
    "host_permissions": [
        "*://*/*"
    ],
    "permissions": [
        "downloads",
        "cookies",
        "webRequest",
        "tabs",
        "storage",
        "contextMenus",
        "alarms",
        "webNavigation"
    ],
    "background": {
        "service_worker": "main.js",
        "type": "module"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "icon48.png"
            ],
            "matches": [
                "*://*/*"
            ]
        }
    ],
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.instagram.com/*"
            ],
            "js": [
                "content-ig.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://*/*"
            ],
            "js": [
                "content-magnet.js"
            ],
            "run_at": "document_start",
            "all_frames": true
        },
        {
            "matches": [
                "*://*/*"
            ],
            "js": [
                "content-bar.js"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ]
}
